# Neon PostgreSQL pooled connection string (runtime application traffic)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require&pgbouncer=true"
# Neon direct connection string (Prisma schema synchronization/migrations)
DIRECT_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
# Used only by prisma/seed.ts to create the first administrator
SEED_ADMIN_NAME="Administrador FilaZero"
SEED_ADMIN_EMAIL="admin@filazero.local"
SEED_ADMIN_PASSWORD="replace-with-a-unique-password-at-least-12-chars"
SEED_ESTABLISHMENT_NAME="Clínica Central"
SEED_ESTABLISHMENT_ADDRESS="Endereço de demonstração"
